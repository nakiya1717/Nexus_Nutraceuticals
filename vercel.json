{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/careers/",
      "destination": "/careers.html"
    },
    {
      "source": "/careers/:slug",
      "destination": "/career-details.html"
    }
  ],
  "functions": {
    "api/[...catchall].js": {
      "includeFiles": "api/*.json"
    }
  }
}